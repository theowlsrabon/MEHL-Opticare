# ============================================================
# MEHL Opticare ERP — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# Neon PostgreSQL connection string (required by backend)
# Get from: console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?channel_binding=require&sslmode=require

# JWT secret for auth token signing (generate a strong random string)
JWT_SECRET=your-jwt-secret-here

# Node environment
NODE_ENV=development
